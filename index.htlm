<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>International Lottery Results - GLO & Saudi</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Sarabun', sans-serif; }
        .glo-blue { background-color: #003366; }
        .saudi-green { background-color: #006633; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 min-h-screen flex flex-col">

    <!-- Top Bar -->
    <div class="glo-blue text-white text-xs py-1 px-4 flex justify-between items-center border-b border-blue-900">
        <div>
            <span id="txt-official">International Lottery Portal (GLO & Saudi)</span>
        </div>
        <div class="flex items-center space-x-4">
            <button id="lang-btn" onclick="toggleLanguage()" class="hover:underline flex items-center gap-1 font-semibold">
                <i class="fa-solid font-bold text-yellow-400 fa-globe"></i> <span id="current-lang">EN</span>
            </button>
            <button onclick="openLoginModal()" class="bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold px-3 py-1 rounded text-xs">
                <i class="fa-solid fa-right-to-bracket mr-1"></i> <span id="txt-login-btn">เข้าสู่ระบบ</span>
            </button>
        </div>
    </div>

    <!-- Header / Logo Area -->
    <header class="bg-white shadow-md py-4 px-6 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <div class="w-14 h-14 rounded-full border-2 border-yellow-500 flex items-center justify-center bg-blue-900 text-white font-bold text-xl shadow">
                INT
            </div>
            <div>
                <h1 id="title-main" class="text-xl font-bold text-blue-900 leading-tight">ระบบตรวจผลสลากนานาชาติ</h1>
                <p id="title-sub" class="text-xs text-gray-500 tracking-wider">THAI & SAUDI LOTTERY RESULTS</p>
            </div>
        </div>
        <!-- Lottery Country Selector Tabs -->
        <div class="flex space-x-2">
            <button onclick="switchLottery('thai')" id="tab-thai" class="px-4 py-2 text-sm font-bold rounded-lg glo-blue text-white shadow transition">
                🇹🇭 Thai GLO
            </button>
            <button onclick="switchLottery('saudi')" id="tab-saudi" class="px-4 py-2 text-sm font-bold rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 transition">
                🇸🇦 Saudi Lottery
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full">
        
        <!-- Banner / Date Selector -->
        <div id="banner-bg" class="bg-gradient-to-r from-blue-900 to-indigo-900 rounded-lg p-6 text-white mb-8 shadow-md transition-all duration-300">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-4 md:mb-0">
                    <span id="banner-badge" class="bg-yellow-500 text-slate-900 text-xs font-bold px-2 py-1 rounded uppercase tracking-wider mb-2 inline-block">Official Announcement</span>
                    <h2 class="text-2xl font-bold mb-1" id="banner-title">ตรวจผลรางวัลสลากกินแบ่งรัฐบาลไทย</h2>
                    <p class="text-sm text-blue-200" id="banner-desc">ตรวจสอบผลการออกรางวัลสลากกินแบ่งรัฐบาลไทย งวดล่าสุด ได้ทางระบบออนไลน์</p>
                </div>
                <div>
                    <label class="block text-xs text-blue-200 mb-1" id="lbl-select-date">เลือกงวดวันที่:</label>
                    <select id="draw-date-select" onchange="renderResults()" class="text-gray-900 rounded px-3 py-2 text-sm font-semibold bg-white border border-gray-300">
                        <!-- Populated via JS -->
                    </select>
                </div>
            </div>
        </div>

        <!-- Dynamic Results Section -->
        <section class="bg-white rounded-lg shadow-md p-6 mb-8 border border-gray-200">
            <div class="flex justify-between items-center border-b pb-4 mb-6">
                <h3 class="text-xl font-bold text-blue-900 flex items-center gap-2" id="results-heading-container">
                    <i class="fa-solid fa-trophy text-yellow-500"></i>
                    <span id="title-draw-results">ผลการออกรางวัลสลากกินแบ่งรัฐบาลไทย</span>
                </h3>
                <span id="draw-status-badge" class="bg-green-100 text-green-800 text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1">
                    <span class="w-2 h-2 bg-green-500 rounded-full animate-ping"></span> Live Results
                </span>
            </div>

            <!-- Thai Results Layout -->
            <div id="thai-results-container">
                <!-- First Prize -->
                <div class="text-center bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
                    <h4 class="text-sm font-bold text-gray-600 mb-2 uppercase tracking-wide" id="lbl-prize-1">รางวัลที่ 1 (Prize 1)</h4>
                    <div class="text-4xl md:text-5xl font-extrabold text-blue-900 tracking-widest font-mono my-2" id="res-thai-1">
                        ------
                    </div>
                    <p class="text-xs text-gray-500" id="lbl-prize-1-val">รางวัลละ 6,000,000 บาท</p>
                </div>

                <!-- Secondary Prizes Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-gray-50 border border-gray-200 rounded p-4 text-center">
                        <h5 class="text-xs font-bold text-gray-600 mb-1" id="lbl-3-front">เลขหน้า 3 ตัว (3-Digit Front)</h5>
                        <div class="text-2xl font-bold text-gray-800 font-mono tracking-widest my-1" id="res-thai-front3">--- , ---</div>
                        <p class="text-xs text-gray-400">2 รางวัลละ 4,000 บาท</p>
                    </div>
                    <div class="bg-gray-50 border border-gray-200 rounded p-4 text-center">
                        <h5 class="text-xs font-bold text-gray-600 mb-1" id="lbl-3-back">เลขท้าย 3 ตัว (3-Digit Back)</h5>
                        <div class="text-2xl font-bold text-gray-800 font-mono tracking-widest my-1" id="res-thai-back3">--- , ---</div>
                        <p class="text-xs text-gray-400">2 รางวัลละ 4,000 บาท</p>
                    </div>
                    <div class="bg-gray-50 border border-gray-200 rounded p-4 text-center">
                        <h5 class="text-xs font-bold text-gray-600 mb-1" id="lbl-2-digit">เลขท้าย 2 ตัว (2-Digit)</h5>
                        <div class="text-2xl font-bold text-gray-800 font-mono tracking-widest my-1" id="res-thai-digit2">--</div>
                        <p class="text-xs text-gray-400">1 รางวัลละ 2,000 บาท</p>
                    </div>
                </div>
            </div>

            <!-- Saudi Results Layout (Hidden by default) -->
            <div id="saudi-results-container" class="hidden">
                <!-- Grand Prize -->
                <div class="text-center bg-emerald-50 border border-emerald-200 rounded-lg p-6 mb-6">
                    <h4 class="text-sm font-bold text-emerald-800 mb-2 uppercase tracking-wide" id="lbl-saudi-grand">Saudi Grand Jackpot Prize</h4>
                    <div class="text-4xl md:text-5xl font-extrabold text-emerald-900 tracking-widest font-mono my-2" id="res-saudi-grand">
                        --------
                    </div>
                    <p class="text-xs text-emerald-700" id="lbl-saudi-grand-val">Prize Value: 10,000,000 SAR</p>
                </div>

                <!-- Secondary Saudi Prizes Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-gray-50 border border-gray-200 rounded p-4 text-center">
                        <h5 class="text-xs font-bold text-gray-600 mb-1" id="lbl-saudi-first">First Tier Prize (الجوائز الكبرى)</h5>
                        <div class="text-xl font-bold text-gray-800 font-mono tracking-widest my-1" id="res-saudi-first">------ , ------</div>
                        <p class="text-xs text-gray-400">500,000 SAR</p>
                    </div>
                    <div class="bg-gray-50 border border-gray-200 rounded p-4 text-center">
                        <h5 class="text-xs font-bold text-gray-600 mb-1" id="lbl-saudi-serial">Lucky Series Match (سلسلة الحظ)</h5>
                        <div class="text-xl font-bold text-gray-800 font-mono tracking-widest my-1" id="res-saudi-serial">----</div>
                        <p class="text-xs text-gray-400">50,000 SAR</p>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="glo-blue text-white py-8 px-4 mt-auto">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
            <div>
                <h5 class="font-bold text-sm mb-2 text-yellow-400" id="footer-title">สำนักงานสลากกินแบ่งรัฐบาล & Saudi Lottery Administration</h5>
                <p class="text-blue-200" id="footer-address">Official Multi-Country Government Lottery Portal 2026</p>
                <p class="text-blue-200 mt-1">Support Helpline: +66 2528 9999 / +966 11 000 0000</p>
            </div>
            <div class="md:text-right flex flex-col justify-between">
                <div>
                    <p class="text-blue-200">&copy; 2026 International Lottery Bureau. All Rights Reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Login Modal -->
    <div id="login-modal" class="fixed inset-0 bg-black bg-opacity-60 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-sm overflow-hidden transform transition-all">
            <div class="glo-blue text-white p-4 flex justify-between items-center">
                <h3 class="font-bold text-base" id="modal-login-title">เข้าสู่ระบบระบบงาน</h3>
                <button onclick="closeLoginModal()" class="text-gray-300 hover:text-white font-bold text-xl">&times;</button>
            </div>
            <form onsubmit="handleLogin(event)" class="p-6">
                <div id="error-msg" class="hidden bg-red-100 border border-red-400 text-red-700 text-xs rounded p-2 mb-4">
                    ชื่อผู้ใช้งานหรือรหัสผ่านไม่ถูกต้อง!
                </div>
                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 mb-1" id="lbl-username">ชื่อผู้ใช้งาน / Username</label>
                    <input type="text" id="username" required placeholder="admin" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-blue-800">
                </div>
                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-700 mb-1" id="lbl-password">รหัสผ่าน / Password</label>
                    <input type="password" id="password" required placeholder="123456" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-blue-800">
                </div>
                <button type="submit" class="w-full glo-blue text-white font-bold py-2 rounded text-sm hover:bg-blue-900 transition">
                    <span id="btn-submit-login">เข้าสู่ระบบ</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Script Section -->
    <script>
        // Active Country State ('thai' or 'saudi')
        let currentCountry = 'thai';
        let currentLang = 'TH';

        // Multi-country Draw Database
        const lotteryDatabase = {
            thai: {
                dates: [
                    { value: "2026-10-16", labelTH: "16 ตุลาคม 2026", labelEN: "16 October 2026" },
                    { value: "2026-10-01", labelTH: "1 ตุลาคม 2026", labelEN: "1 October 2026" },
                    { value: "2026-09-16", labelTH: "16 กันยายน 2026", labelEN: "16 September 2026" }
                ],
                data: {
                    "2026-10-16": { prize1: "951832", front3: ["241", "598"], back3: ["113", "762"], digit2: "54" },
                    "2026-10-01": { prize1: "743285", front3: ["120", "349"], back3: ["672", "891"], digit2: "92" },
                    "2026-09-16": { prize1: "619412", front3: ["035", "421"], back3: ["518", "904"], digit2: "17" }
                }
            },
            saudi: {
                dates: [
                    { value: "2026-10-15", labelTH: "15 ตุลาคม 2026 (ซาอุฯ)", labelEN: "15 October 2026 (Saudi)" },
                    { value: "2026-10-01", labelTH: "1 ตุลาคม 2026 (ซาอุฯ)", labelEN: "1 October 2026 (Saudi)" },
                    { value: "2026-09-15", labelTH: "15 กันยายน 2026 (ซาอุฯ)", labelEN: "15 September 2026 (Saudi)" }
                ],
                data: {
                    "2026-10-15": { grand: "84920173", first: ["492018", "920173"], serial: "7421" },
                    "2026-10-01": { grand: "31849205", first: ["184920", "849205"], serial: "3912" },
                    "2026-09-15": { grand: "62948102", first: ["294810", "948102"], serial: "8540" }
                }
            }
        };

        // Switch between Thai and Saudi systems
        function switchLottery(country) {
            currentCountry = country;
            const tabThai = document.getElementById("tab-thai");
            const tabSaudi = document.getElementById("tab-saudi");
            const bannerBg = document.getElementById("banner-bg");

            if (country === 'thai') {
                tabThai.className = "px-4 py-2 text-sm font-bold rounded-lg glo-blue text-white shadow transition";
                tabSaudi.className = "px-4 py-2 text-sm font-bold rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 transition";
                bannerBg.className = "bg-gradient-to-r from-blue-900 to-indigo-900 rounded-lg p-6 text-white mb-8 shadow-md transition-all duration-300";
                
                document.getElementById("thai-results-container").classList.remove("hidden");
                document.getElementById("saudi-results-container").classList.add("hidden");
            } else {
                tabSaudi.className = "px-4 py-2 text-sm font-bold rounded-lg saudi-green text-white shadow transition";
                tabThai.className = "px-4 py-2 text-sm font-bold rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 transition";
                bannerBg.className = "bg-gradient-to-r from-emerald-800 to-teal-900 rounded-lg p-6 text-white mb-8 shadow-md transition-all duration-300";
                
                document.getElementById("saudi-results-container").classList.remove("hidden");
                document.getElementById("thai-results-container").classList.add("hidden");
            }

            populateDateDropdown();
            renderResults();
            updateTextContent();
        }

        // Populate Date Dropdown based on active country & language
        function populateDateDropdown() {
            const select = document.getElementById("draw-date-select");
            select.innerHTML = "";
            const countryObj = lotteryDatabase[currentCountry];
            
            countryObj.dates.forEach(d => {
                const opt = document.createElement("option");
                opt.value = d.value;
                opt.innerText = currentLang === 'TH' ? d.labelTH : d.labelEN;
                select.appendChild(opt);
            });
        }

        // Render Lottery Results
        function renderResults() {
            const date = document.getElementById("draw-date-select").value;
            const countryObj = lotteryDatabase[currentCountry];
            const data = countryObj.data[date];

            if (!data) return;

            if (currentCountry === 'thai') {
                document.getElementById("res-thai-1").innerText = data.prize1;
                document.getElementById("res-thai-front3").innerText = data.front3.join(" , ");
                document.getElementById("res-thai-back3").innerText = data.back3.join(" , ");
                document.getElementById("res-thai-digit2").innerText = data.digit2;
            } else {
                document.getElementById("res-saudi-grand").innerText = data.grand;
                document.getElementById("res-saudi-first").innerText = data.first.join(" , ");
                document.getElementById("res-saudi-serial").innerText = data.serial;
            }
        }

        // Modal Controls
        function openLoginModal() {
            document.getElementById("login-modal").classList.remove("hidden");
        }

        function closeLoginModal() {
            document.getElementById("login-modal").classList.add("hidden");
            document.getElementById("error-msg").classList.add("hidden");
        }

        // Login Handling
        function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById("username").value;
            const p = document.getElementById("password").value;

            if (u === "admin" && p === "123456") {
                alert("เข้าสู่ระบบสำเร็จ! (Login Successful)");
                closeLoginModal();
            } else {
                document.getElementById("error-msg").classList.remove("hidden");
            }
        }

        // Toggle Language (TH <-> EN)
        function toggleLanguage() {
            currentLang = currentLang === 'TH' ? 'EN' : 'TH';
            document.getElementById("current-lang").innerText = currentLang === 'TH' ? 'EN' : 'TH';
            updateTextContent();
            populateDateDropdown();
            renderResults();
        }

        // Update Dynamic UI Text
        function updateTextContent() {
            if (currentLang === 'EN') {
                document.getElementById("txt-official").innerText = "International Lottery Portal";
                document.getElementById("txt-login-btn").innerText = "Log In";
                document.getElementById("title-main").innerText = "International Lottery Bureau";
                
                if (currentCountry === 'thai') {
                    document.getElementById("banner-title").innerText = "Check Thai GLO Lottery Results";
                    document.getElementById("banner-desc").innerText = "Check official Thai government lottery draw results online.";
                    document.getElementById("title-draw-results").innerText = "Official Thai GLO Draw Results";
                } else {
                    document.getElementById("banner-title").innerText = "Check Saudi Lottery Results";
                    document.getElementById("banner-desc").innerText = "Check official Saudi lottery draw results online instantly.";
                    document.getElementById("title-draw-results").innerText = "Official Saudi Lottery Draw Results";
                }
            } else {
                document.getElementById("txt-official").innerText = "International Lottery Portal (GLO & Saudi)";
                document.getElementById("txt-login-btn").innerText = "เข้าสู่ระบบ";
                document.getElementById("title-main").innerText = "ระบบตรวจผลสลากนานาชาติ";
                
                if (currentCountry === 'thai') {
                    document.getElementById("banner-title").innerText = "ตรวจผลรางวัลสลากกินแบ่งรัฐบาลไทย";
                    document.getElementById("banner-desc").innerText = "ตรวจสอบผลการออกรางวัลสลากกินแบ่งรัฐบาลไทย งวดล่าสุด ได้ทางระบบออนไลน์";
                    document.getElementById("title-draw-results").innerText = "ผลการออกรางวัลสลากกินแบ่งรัฐบาลไทย";
                } else {
                    document.getElementById("banner-title").innerText = "ตรวจผลรางวัลสลากซาอุดีอาระเบีย";
                    document.getElementById("banner-desc").innerText = "ตรวจสอบผลการออกรางวัลสลากซาอุดีอาระเบีย งวดล่าสุด ได้ทางระบบออนไลน์";
                    document.getElementById("title-draw-results").innerText = "ผลการออกรางวัลสลากซาอุดีอาระเบีย";
                }
            }
        }

        // Initialize on load
        window.onload = function() {
            populateDateDropdown();
            renderResults();
        };
    </script>
</body>
</html>
```html
<!DOCTYPE html>
<html lang="th" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>สำนักงานสลากกินแบ่งรัฐบาล | The Government Lottery Office (GLO)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font: Sarabun (Official Standard Thai Font) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        glo: {
                            navy: '#00264d',
                            blue: '#0a4275',
                            accent: '#0066cc',
                            gold: '#d4af37',
                            goldlight: '#f9f3d9',
                            goldhover: '#b59223',
                            bglight: '#f4f7fa'
                        }
                    },
                    fontFamily: {
                        sans: ['Sarabun', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Sarabun', sans-serif;
        }
        .hero-slide {
            display: none;
            transition: opacity 0.5s ease-in-out;
        }
        .hero-slide.active {
            display: flex;
            opacity: 1;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen text-slate-800 bg-slate-50 antialiased selection:bg-glo-accent selection:text-white">

    <!-- Top Utility Bar -->
    <div class="bg-glo-navy text-white text-xs sm:text-sm py-2 px-4 border-b border-glo-gold/30">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center space-x-4">
                <span class="flex items-center"><i class="fa-solid fa-building-columns mr-1.5 text-glo-gold"></i> <span data-i18n="gov_portal">เว็บไซต์อย่างเป็นทางการของรัฐบาลไทย</span></span>
                <span class="hidden md:inline-block text-slate-400">|</span>
                <span class="hidden md:flex items-center"><i class="fa-solid fa-phone mr-1.5 text-glo-gold"></i> GLO Call Center: 0 2528 9999</span>
            </div>
            <div class="flex items-center space-x-4 ml-auto">
                <div class="flex items-center space-x-1 bg-glo-blue/80 px-2 py-0.5 rounded text-xs border border-glo-gold/20">
                    <button id="lang-th" onclick="setLanguage('th')" class="px-2 py-0.5 rounded font-bold bg-glo-gold text-glo-navy">TH</button>
                    <button id="lang-en" onclick="setLanguage('en')" class="px-2 py-0.5 rounded text-slate-200 hover:text-white">EN</button>
                </div>
                <button onclick="openModal('loginModal')" class="hover:text-glo-gold transition flex items-center gap-1 font-medium">
                    <i class="fa-regular fa-user"></i> <span data-i18n="login">เข้าสู่ระบบ</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Official Header -->
    <header class="bg-white shadow-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-3 sm:py-4 flex items-center justify-between">
            
            <!-- Logo & Brand Header -->
            <a href="#" class="flex items-center gap-3">
