        let currentLang = 'th';

        function setLanguage(lang) {
            currentLang = lang;
            
            if(lang === 'th') {
                document.getElementById('lang-th').className = "px-2 py-0.5 rounded font-bold bg-glo-gold text-glo-navy";
                document.getElementById('lang-en').className = "px-2 py-0.5 rounded text-slate-200 hover:text-white";
            } else {
                document.getElementById('lang-en').className = "px-2 py-0.5 rounded font-bold bg-glo-gold text-glo-navy";
                document.getElementById('lang-th').className = "px-2 py-0.5 rounded text-slate-200 hover:text-white";
            }

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang][key]) {
                    el.textContent = translations[lang][key];
                }
            });

            document.querySelectorAll('[data-i18n-ph]').forEach(el => {
                const key = el.getAttribute('data-i18n-ph');
                if (translations[lang][key]) {
                    el.placeholder = translations[lang][key];
                }
            });
        }

        // Hero Banner Slide Control
        let currentSlide = 0;
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('.slide-dot');

        function setSlide(index) {
            slides[currentSlide].classList.remove('active');
            dots[currentSlide].className = "slide-dot w-3 h-3 rounded-full bg-white/40 hover:bg-white transition-all duration-300";
            
            currentSlide = index;
            
            slides[currentSlide].classList.add('active');
            dots[currentSlide].className = "slide-dot w-3 h-3 rounded-full bg-glo-gold transition-all duration-300";
        }

        setInterval(() => {
            let nextSlide = (currentSlide + 1) % slides.length;
            setSlide(nextSlide);
        }, 6000);

        // Mobile Menu Drawer Handler
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Modal Handler
        function openModal(modalId) {
            const backdrop = document.getElementById('modalBackdrop');
            backdrop.classList.remove('hidden');
            
            document.querySelectorAll('.modal-box').forEach(box => box.classList.add('hidden'));
            
            const target = document.getElementById(modalId);
            if(target) target.classList.remove('hidden');
        }

        function closeModal(modalId) {
            const backdrop = document.getElementById('modalBackdrop');
            backdrop.classList.add('hidden');
            document.getElementById(modalId).classList.add('hidden');
        }

        // Category Filter
        function filterNews(type) {
            const cards = document.querySelectorAll('.news-card');
            const btns = document.querySelectorAll('.news-tab-btn');

            btns.forEach(btn => {
                btn.className = "news-tab-btn bg-slate-200 text-slate-700 hover:bg-slate-300 px-3 py-1.5 rounded-full transition";
            });

            event.target.className = "news-tab-btn active bg-glo-navy text-white px-3 py-1.5 rounded-full transition";

            cards.forEach(card => {
                if(type === 'all' || card.classList.contains(type)) {
                    card.style.display = "flex";
                } else {
                    card.style.display = "none";
                }
            });
        }

        // Guidance Search Simulation
        function searchGuidance() {
            const input = document.getElementById('guidanceSearchInput').value.trim();
            const resultBox = document.getElementById('guidanceResult');
            const resultText = document.getElementById('guidanceResultText');

            if(!input) {
                resultBox.classList.add('hidden');
                return;
            }

            resultBox.classList.remove('hidden');
            if(currentLang === 'th') {
                resultText.textContent = `ข้อแนะนำสำหรับหัวข้อ "${input}": กรุณาติดต่อ GLO Call Center 0 2528 9999 หรือเข้าอ่านรายละเอียดได้ที่ศูนย์บริการประชาชน`;
            } else {
                resultText.textContent = `Guidance for keyword "${input}": Please contact GLO Call Center at 0 2528 9999 or check our online portal guidelines.`;
            }
        }

        function handleSearch() {
            const val = document.getElementById('headerSearchInput').value.trim();
            if(val) {
                searchGuidance();
            }
        }
    </script>
</body>
</html>
```
