        <div id="loginModal" class="modal-box bg-white rounded-xl shadow-2xl max-w-sm w-full overflow-hidden hidden">
            <div class="bg-glo-navy text-white p-4 flex justify-between items-center">
                <h3 class="font-bold text-sm" data-i18n="login">เข้าสู่ระบบระบบงาน</h3>
                <button onclick="closeModal('loginModal')" class="text-slate-300 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">ชื่อผู้ใช้งาน / Username</label>
                    <input type="text" placeholder="ระบุชื่อผู้ใช้งาน" class="w-full p-2.5 border rounded-lg text-sm focus:ring-2 focus:ring-glo-blue/40 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">รหัสผ่าน / Password</label>
                    <input type="password" placeholder="••••••••" class="w-full p-2.5 border rounded-lg text-sm focus:ring-2 focus:ring-glo-blue/40 focus:outline-none">
                </div>
                <button onclick="closeModal('loginModal')" class="w-full bg-glo-blue hover:bg-glo-navy text-white font-bold py-2.5 rounded-lg text-sm transition">
                    เข้าสู่ระบบ
                </button>
            </div>
